# ==============================================================================
# HAMMAD STUDYHUB — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Created by Muhammad Hammad
#
# IMPORTANT:
# 1. Copy this file to `.env` for local development.
# 2. Never commit `.env` containing real keys to version control.
# 3. Only variables prefixed with VITE_ are accessible to the browser.
# 4. NEVER place Supabase service-role keys or secret API keys in this file.
# ==============================================================================

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Public API Key (safe for client-side use)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Set to "true" to force local demo mock data even if Supabase is connected
# Useful for local component development and automated test suites
VITE_DEMO_MODE=false

# Platform metadata
VITE_APP_TITLE="Hammad StudyHub"
VITE_APP_CREATOR="Muhammad Hammad"

# ==============================================================================
# GOOGLE DRIVE API INTEGRATION (AUTOMATIC SUBJECT FOLDER UPLOADS)
# ==============================================================================
# Choose either Option A (Google Service Account - Recommended) or Option B (OAuth):
#
# Option A: Google Service Account (Recommended for Vercel Serverless Function)
# 1. Create a Project in Google Cloud Console (https://console.cloud.google.com).
# 2. Enable the "Google Drive API".
# 3. Create a Service Account (IAM & Admin -> Service Accounts).
# 4. Create and download a JSON key for the Service Account.
# 5. Share your subject Google Drive folders with the Service Account email (give Editor role).
# 6. Paste the JSON key in Vercel environment variables as GOOGLE_SERVICE_ACCOUNT_KEY:
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Option B: Client-side / User Google OAuth 2.0 (Google Identity Services)
# 1. In Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth 2.0 Client ID (Web Application).
# 2. Add Authorised JavaScript origins: https://hammadstudyhub.vercel.app and http://localhost:3000
# 3. Put the Client ID here:
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

